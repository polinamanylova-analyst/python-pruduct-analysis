    "# Соединяю отфильтрованную таблицу с заказами и таблицу с клиентами, чтобы дальше исппользовать уникальные id клиентов\n",
    "merged_orders_customers = pd.merge(olist_orders_filtred, olist_customers, on = 'customer_id', how = 'inner')\n",
    "\n",
    "# Создаю временные периоды для когорт \n",
    "merged_orders_customers['order_perid']= merged_orders_customers['order_purchase_timestamp'].dt.to_period('M')\n",
    "merged_orders_customers['order_perid_day']= merged_orders_customers['order_purchase_timestamp'].dt.to_period('D')\n",
    "\n",
    "# Нахожу дату первого заказа (минимальную)\n",
    "merged_orders_customers['cohort'] = merged_orders_customers.groupby('customer_unique_id')['order_purchase_timestamp'].transform('min').dt.to_period('M')\n",
    "merged_orders_customers['cohort_day'] = merged_orders_customers.groupby('customer_unique_id')['order_purchase_timestamp'].transform('min').dt.to_period('D')\n",
    "merged_orders_customers.head()"
   ]
  },
