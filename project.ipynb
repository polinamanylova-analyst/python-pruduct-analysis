   "source": [
    "import pandas as pd\n",
    "from operator import attrgetter\n",
    "import seaborn as sns\n",
    "import numpy as np\n",
    "\n",
    "olist_customers = pd.read_csv('/mnt/HC_Volume_18315164/home-jupyter/jupyter-polina-manylova-bea7493/olist_customers_dataset.csv')\n",
    "olist_order_items = pd.read_csv('/mnt/HC_Volume_18315164/home-jupyter/jupyter-polina-manylova-bea7493/olist_order_items_dataset.csv')\n",
    "olist_orders = pd.read_csv('/mnt/HC_Volume_18315164/home-jupyter/jupyter-polina-manylova-bea7493/olist_orders_dataset.csv')\n",
    "\n",
    "# Перевод колон с датами в нужный формат \n",
    "cols = ['order_purchase_timestamp', 'order_approved_at', 'order_delivered_carrier_date', 'order_delivered_customer_date', 'order_estimated_delivery_date']\n",
    "olist_orders[cols] = olist_orders[cols].apply(pd.to_datetime)\n",
    "olist_order_items['shipping_limit_date'] = pd.to_datetime(olist_order_items['shipping_limit_date'])\n"
   ]
