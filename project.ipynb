  },
  {
   "cell_type": "markdown",
   "id": "ee8afb1b",
   "metadata": {},
   "source": [
    "№5 Метрика - LTV. Покажет сколько денег приносит клиент на протяжении всей жизни в продукте."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 30,
   "id": "710deabb",
   "metadata": {},
   "outputs": [],
   "source": [
    "full_df_2 = full_df.merge(merged_orders_customers[['customer_unique_id', 'cohort', 'perid_namber_month']], on='customer_unique_id', how='left')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 32,
   "id": "e2214f64",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Строю такую же матрицу как с когортами и ретеншн, но беру сумму продаж\n",
    "cohort_revenue_pivot = full_df_2.pivot_table(\n",
    "    index='cohort', \n",
    "    columns='perid_namber_month', \n",
    "    values='total_price',\n",
    "    aggfunc='sum')\n",
    "\n",
    "revenue_per_customer_matrix = cohort_revenue_pivot.divide(cohort_size, axis=0)\n",
    "ltv_matrix = revenue_per_customer_matrix.cumsum(axis=1)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 33,
   "id": "ce028834",
   "metadata": {},
   "outputs": [],
   "source": [
    "total_cumulative_revenue = cohort_revenue_pivot.cumsum(axis=1).sum(axis=0)\n",
    "active_sizes = cohort_revenue_pivot.notna().multiply(cohort_size, axis=0).sum(axis=0)\n",
    "avg_ltv_by_month = total_cumulative_revenue / active_sizes"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 35,
   "id": "4786fc0e",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "Text(0, 0.5, 'LTV')"
