   "source": [
    "# Посмотрим сколько задержек приходится на штат, разделив их по популярности (как много заказов было сделано из каждого штата)\n",
    "\n",
    "full_df['is_delayed'] = (full_df['order_estimated_delivery_date'] - full_df['order_delivered_customer_date']).dt.days < 0\n",
    "\n",
    "state_analysis = full_df.groupby('customer_state').agg(orders_count=('order_id', 'nunique'),delayed_orders_share=('is_delayed', 'mean')).sort_values(by='orders_count', ascending=False)\n",
    "\n",
    "state_analysis['share_of_total_orders'] = state_analysis['orders_count'] / state_analysis['orders_count'].sum()\n",
    "state_analysis.head(10)"
   ]
  },
