   "execution_count": 4,
   "id": "c35b13de",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Считаю сами значения когорт \n",
    "merged_orders_customers['perid_namber_month'] = np.floor((merged_orders_customers.order_perid_day - merged_orders_customers.cohort_day).apply(attrgetter('n'))/30)\n",
    "dt_cohort = merged_orders_customers.groupby(['cohort', 'perid_namber_month']).agg(n_customers = ('customer_unique_id', 'nunique')).reset_index()"
   ]
  },
