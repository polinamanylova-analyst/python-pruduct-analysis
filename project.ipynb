    "# Формируем матрицу с retetion по когортам  \n",
    "cohort_pivot = dt_cohort.pivot_table(index = 'cohort', columns = 'perid_namber_month', values = 'n_customers')\n",
    "cohort_size = cohort_pivot.loc[:, 0]\n",
    "retation_matrix = cohort_pivot.divide(cohort_size, axis = 0)\n",
    "retation_matrix"
   ]
  },
