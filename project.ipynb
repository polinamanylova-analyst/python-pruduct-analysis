   "source": [
    "# Можно посмотреть могла ли повлиять логистика. Возможно многие заказы задерживались, из-за чего пользователи больше не\n",
    "# заказывали с нашего маркетплейса \n",
    "\n",
    "# Сравниваю обещанную дату доставки с фактической, чтобы оценить задержки\n",
    "\n",
    "# Соединяю изначальные датафреймы без фильтров\n",
    "merged_orders_customers_not_filtered = pd.merge(olist_orders, olist_customers, on = 'customer_id', how = 'inner')\n",
    "\n",
    "logistic = merged_orders_customers_not_filtered[['customer_city', 'customer_state', 'order_approved_at', 'order_delivered_carrier_date', 'order_delivered_customer_date', 'order_estimated_delivery_date']]\n",
    "logistic['fact/plan'] = logistic.order_estimated_delivery_date - logistic.order_delivered_customer_date\n",
    "logistic_filtered = logistic[logistic['fact/plan'] < pd.Timedelta(0)]\n",
    "logistic_filtered"
   ]
  },
